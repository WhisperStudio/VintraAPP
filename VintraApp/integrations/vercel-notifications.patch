@@ -0,0 +1,42 @@
+import { createHash } from 'node:crypto';
+
+export const hash = (value) => createHash('sha256').update(value).digest('hex');
+export const validToken = (token) =>
+  typeof token === 'string' &&
+  /^(ExponentPushToken|ExpoPushToken)\[[\w-]+\]$/.test(token);
+export const isSuperAdmin = (token) =>
+  token?.email_verified === true &&
+  (token.superAdmin === true ||
+    token.email?.toLowerCase() === 'vintrastudio@gmail.com');
+export const isMember = (business, membership, uid) =>
+  business?.ownerId === uid ||
+  (membership &&
+    ['owner', 'admin', 'support'].includes(membership.role) &&
+    (membership.status || 'active') === 'active');
+export function messageKey(message) {
+  return String(
+    message.id ||
+      hash(JSON.stringify([message.role, message.text, message.createdAt])),
+  );
+}
+export function incomingMessages(before, after) {
+  const seen = new Set((before?.messages || []).map(messageKey));
+  return (after?.messages || []).filter((message) => {
+    const key = messageKey(message);
+    if (seen.has(key)) return false;
+    seen.add(key);
+    return (
+      (!message.role || message.role === 'user') &&
+      typeof message.text === 'string' &&
+      message.text.trim()
+    );
+  });
+}
+export function channelId(sound = true, vibration = true) {
+  return `messages-${sound ? 'sound' : 'silent'}-${vibration ? 'vibrate' : 'still'}`;
+}
+export function deliveryStatus(total, accepted, failed) {
+  if (!total) return 'no-recipients';
+  if (!failed) return 'accepted';
+  return accepted ? 'partial' : 'failed';
+}
diff --git a/my-app/src/lib/notifications/http.mjs b/my-app/src/lib/notifications/http.mjs
new file mode 100644
index 0000000..e98da66
--- /dev/null
+++ b/my-app/src/lib/notifications/http.mjs
@@ -0,0 +1,132 @@
+import { NotificationError } from './service.mjs';
+
+const actions = new Set([
+  'registerNotificationDevice',
+  'unregisterNotificationDevice',
+  'notificationCenter',
+  'queueAnnouncement',
+]);
+const statuses = {
+  unauthenticated: 401,
+  'permission-denied': 403,
+  'invalid-argument': 400,
+  'not-found': 404,
+  unavailable: 503,
+};
+
+export function createNotificationHandler({
+  verifyToken,
+  service,
+  schedule,
+  enabled,
+  origins,
+}) {
+  return async function handle(request) {
+    const origin = request.headers.get('origin');
+    const headers = { 'Cache-Control': 'no-store', Vary: 'Origin' };
+    if (origin && !origins.includes(origin))
+      return Response.json(
+        { error: { message: 'Origin not allowed.' } },
+        { status: 403, headers },
+      );
+    if (origin) headers['Access-Control-Allow-Origin'] = origin;
+    headers['Access-Control-Allow-Methods'] = 'POST, OPTIONS';
+    headers['Access-Control-Allow-Headers'] = 'Authorization, Content-Type';
+    const reply = (value, status = 200) =>
+      Response.json(value, { status, headers });
+    if (request.method === 'OPTIONS')
+      return new Response(null, { status: 204, headers });
+    if (request.method !== 'POST')
+      return reply({ error: { message: 'Use POST.' } }, 405);
+    if (!enabled())
+      return reply(
+        {
+          error: {
+            code: 'unavailable',
+            message:
+              'Notifications are not activated yet. Please try again later.',
+          },
+        },
+        503,
+      );
+    try {
+      const bearer = request.headers
+        .get('authorization')
+        ?.match(/^Bearer (\S+)$/i)?.[1];
+      if (!bearer)
+        throw new NotificationError(
+          'unauthenticated',
+          'Sign in to connect notifications.',
+        );
+      let token;
+      try {
+        token = await verifyToken(bearer);
+      } catch {
+        throw new NotificationError(
+          'unauthenticated',
+          'Your session expired. Sign in again.',
+        );
+      }
+      if (token.email_verified !== true)
+        throw new NotificationError(
+          'permission-denied',
+          'Verify your email before connecting notifications.',
+        );
+      if (Number(request.headers.get('content-length')) > 16384)
+        return reply({ error: { message: 'Request too large.' } }, 413);
+      const raw = await request.text();
+      if (new TextEncoder().encode(raw).length > 16384)
+        return reply({ error: { message: 'Request too large.' } }, 413);
+      let input;
+      try {
+        input = JSON.parse(raw);
+      } catch {
+        throw new NotificationError(
+          'invalid-argument',
+          'Invalid JSON request.',
+        );
+      }
+      if (
+        !input ||
+        !actions.has(input.action) ||
+        !input.data ||
+        typeof input.data !== 'object' ||
+        Array.isArray(input.data)
+      ) {
+        throw new NotificationError(
+          'invalid-argument',
+          'Invalid notification request.',
+        );
+      }
+      const api = service();
+      const result = await api[input.action]({
+        auth: { uid: token.uid, token },
+        data: input.data,
+      });
+      schedule(() =>
+        api.drain(input.action === 'queueAnnouncement' ? result.id : undefined),
+      );
+      return reply({ data: result });
+    } catch (error) {
+      if (error instanceof NotificationError)
+        return reply(
+          { error: { code: error.code, message: error.message } },
+          statuses[error.code] || 400,
+        );
+      // Do not expose credentials, Firestore internals or notification tokens.
+      console.error(
+        'Notification request failed',
+        error?.code || error?.name || 'UnknownError',
+      );
+      return reply(
+        {
+          error: {
+            code: 'internal',
+            message: 'Could not connect notifications. Please try again.',
+          },
+        },
+        500,
+      );
+    }
+  };
+}
diff --git a/my-app/src/lib/notifications/service.mjs b/my-app/src/lib/notifications/service.mjs
new file mode 100644
index 0000000..c14b4da
--- /dev/null
+++ b/my-app/src/lib/notifications/service.mjs
@@ -0,0 +1,458 @@
+import { FieldValue, Timestamp } from 'firebase-admin/firestore';
+import {
+  hash,
+  validToken,
+  isSuperAdmin,
+  isMember,
+  incomingMessages,
+  messageKey,
+  channelId,
+  deliveryStatus,
+} from './core.mjs';
+
+export class NotificationError extends Error {
+  constructor(code, message) {
+    super(message);
+    this.code = code;
+  }
+}
+
+// No credentials, listeners, timers or scheduled Firebase Functions at import time.
+export function createNotificationService(
+  db,
+  { fetchImpl = fetch, accessToken = '' } = {},
+) {
+  const devices = db.collection('notificationDevices');
+  const jobs = db.collection('notificationJobs');
+  const receipts = db.collection('notificationReceipts');
+  function requireUser(request) {
+    if (!request.auth || request.auth.token.email_verified !== true)
+      throw new NotificationError(
+        'unauthenticated',
+        'Sign in with a verified account.',
+      );
+    return request.auth;
+  }
+  function requireAdmin(request) {
+    const auth = requireUser(request);
+    if (!isSuperAdmin(auth.token))
+      throw new NotificationError(
+        'permission-denied',
+        'Only a notification administrator can send announcements.',
+      );
+    return auth;
+  }
+  async function hasAccess(uid, businessId) {
+    const [business, member] = await Promise.all([
+      db.doc(`businesses/${businessId}`).get(),
+      db.doc(`businesses/${businessId}/users/${uid}`).get(),
+    ]);
+    return business.exists && isMember(business.data(), member.data(), uid);
+  }
+
+  async function registerNotificationDevice(request) {
+    const auth = requireUser(request);
+    const { token, businessIds, enabled, sound, vibration, platform } =
+      request.data || {};
+    if (
+      !validToken(token) ||
+      !Array.isArray(businessIds) ||
+      businessIds.length > 100 ||
+      !['ios', 'android'].includes(platform)
+    ) {
+      throw new NotificationError(
+        'invalid-argument',
+        'Invalid device registration.',
+      );
+    }
+    const allowed = [];
+    for (const id of new Set(businessIds)) {
+      if (typeof id !== 'string' || !id || id.includes('/'))
+        throw new NotificationError('invalid-argument', 'Invalid business.');
+      if (await hasAccess(auth.uid, id)) allowed.push(id);
+    }
+    // One record per physical token: multiple phones never overwrite each other.
+    // Reassignment on login prevents the previous account receiving private messages.
+    await devices.doc(hash(token)).set({
+      token,
+      userId: auth.uid,
+      businessIds: allowed,
+      enabled: enabled !== false,
+      sound: sound !== false,
+      vibration: vibration !== false,
+      platform,
+      updatedAt: FieldValue.serverTimestamp(),
+    });
+    return { registered: true, businesses: allowed.length };
+  }
+
+  async function unregisterNotificationDevice(request) {
+    const auth = requireUser(request);
+    if (!validToken(request.data?.token))
+      throw new NotificationError('invalid-argument', 'Invalid token.');
+    const ref = devices.doc(hash(request.data.token));
+    await db.runTransaction(async (tx) => {
+      const snap = await tx.get(ref);
+      if (snap.data()?.userId === auth.uid) tx.delete(ref);
+    });
+    return { removed: true };
+  }
+
+  async function notificationCenter(request) {
+    requireAdmin(request);
+    const [businesses, registered, history] = await Promise.all([
+      db.collection('businesses').get(),
+      devices.where('enabled', '==', true).get(),
+      db
+        .collection('notificationAnnouncements')
+        .orderBy('createdAt', 'desc')
+        .limit(50)
+        .get(),
+    ]);
+    return {
+      businesses: businesses.docs.map((d) => ({
+        id: d.id,
+        name: d.data().businessName || d.data().name || d.id,
+        devices: registered.docs.filter((device) =>
+          device.data().businessIds?.includes(d.id),
+        ).length,
+      })),
+      devices: registered.size,
+      history: (
+        await Promise.all(history.docs.map((d) => jobs.doc(d.id).get()))
+      )
+        .filter((d) => d.exists)
+        .map((d) => ({
+          id: d.id,
+          ...d.data(),
+          createdAt: d.data().createdAt?.toMillis() || 0,
+        })),
+    };
+  }
+
+  async function queueAnnouncement(request) {
+    const auth = requireAdmin(request);
+    const { title, body, targetBusinessId, requestId, testToken } =
+      request.data || {};
+    if (
+      typeof title !== 'string' ||
+      !title.trim() ||
+      title.length > 80 ||
+      typeof body !== 'string' ||
+      !body.trim() ||
+      body.length > 300 ||
+      typeof targetBusinessId !== 'string' ||
+      !targetBusinessId ||
+      targetBusinessId.includes('/') ||
+      typeof requestId !== 'string' ||
+      !/^[\w-]{12,100}$/.test(requestId)
+    ) {
+      throw new NotificationError(
+        'invalid-argument',
+        'Choose an audience and enter a title (80 characters) and message (300 characters).',
+      );
+    }
+    if (testToken) {
+      if (!validToken(testToken))
+        throw new NotificationError(
+          'invalid-argument',
+          'Register this device first.',
+        );
+      const device = await devices.doc(hash(testToken)).get();
+      if (device.data()?.userId !== auth.uid || !device.data()?.enabled)
+        throw new NotificationError(
+          'permission-denied',
+          'Enable notifications on this device first.',
+        );
+    } else if (
+      targetBusinessId !== 'all' &&
+      !(await db.doc(`businesses/${targetBusinessId}`).get()).exists
+    ) {
+      throw new NotificationError(
+        'not-found',
+        'This business no longer exists.',
+      );
+    }
+    const id = hash(`${auth.uid}:${requestId}`);
+    await db.runTransaction(async (tx) => {
+      const ref = jobs.doc(id);
+      if ((await tx.get(ref)).exists) return;
+      tx.create(db.collection('notificationAnnouncements').doc(id), {
+        createdAt: FieldValue.serverTimestamp(),
+      });
+      tx.create(ref, {
+        kind: 'announcement',
+        title: title.trim(),
+        body: body.trim(),
+        targetBusinessId,
+        ...(testToken ? { testToken } : {}),
+        createdBy: auth.uid,
+        createdAt: FieldValue.serverTimestamp(),
+        status: 'queued',
+        data: { type: 'announcement' },
+      });
+    });
+    return { id, status: 'queued' };
+  }
+
+  async function expo(path, payload) {
+    const response = await fetchImpl(
+      `https://exp.host/--/api/v2/push/${path}`,
+      {
+        method: 'POST',
+        headers: {
+          'Content-Type': 'application/json',
+          ...(accessToken ? { Authorization: `Bearer ${accessToken}` } : {}),
+        },
+        body: JSON.stringify(payload),
+        signal: AbortSignal.timeout(20000),
+      },
+    );
+    if (!response.ok)
+      throw new Error(`Push service returned ${response.status}`);
+    const json = await response.json();
+    if (!json.data)
+      throw new Error(
+        json.errors?.[0]?.message || 'Invalid push service response',
+      );
+    return json.data;
+  }
+
+  async function deliver(ref, deadline = Date.now() + 120000) {
+    const job = await db.runTransaction(async (tx) => {
+      const snap = await tx.get(ref);
+      const data = snap.data();
+      if (
+        !data ||
+        !['queued', 'retry', 'sending'].includes(data.status) ||
+        data.leaseUntil?.toMillis() > Date.now()
+      )
+        return null;
+      tx.update(ref, {
+        status: 'sending',
+        leaseUntil: Timestamp.fromMillis(Date.now() + 180000),
+        attempts: FieldValue.increment(1),
+      });
+      return data;
+    });
+    if (!job) return;
+    try {
+      // Single-field queries keep setup independent of composite Firestore indexes.
+      let target = devices.where('enabled', '==', true);
+      if (job.testToken) target = devices.where('token', '==', job.testToken);
+      else if (job.targetBusinessId !== 'all')
+        target = devices.where(
+          'businessIds',
+          'array-contains',
+          job.targetBusinessId,
+        );
+      const snapshot = await target.get();
+      let accepted = job.sentCount || 0;
+      let failed = job.failedCount || 0;
+      const errors = new Set(job.errors || []);
+      for (const device of snapshot.docs) {
+        if (Date.now() + 22000 > deadline) {
+          await ref.update({ status: 'queued', leaseUntil: null });
+          return;
+        }
+        const attemptRef = ref.collection('attempts').doc(device.id);
+        if ((await attemptRef.get()).exists) continue;
+        const current = await device.ref.get();
+        const d = current.data();
+        if (!d?.enabled || !validToken(d.token)) continue;
+        if (job.testToken && d.userId !== job.createdBy) continue;
+        if (
+          job.targetBusinessId !== 'all' &&
+          !job.testToken &&
+          !(await hasAccess(d.userId, job.targetBusinessId))
+        )
+          continue;
+        // Persist the result before moving to the next device. Retries skip accepted tickets.
+        const tickets = await expo('send', [
+          {
+            to: d.token,
+            title: job.title,
+            body: job.body,
+            data: { ...job.data, notificationId: ref.id },
+            sound: d.sound ? 'default' : null,
+            channelId: channelId(d.sound, d.vibration),
+            priority: 'high',
+            ttl: 86400,
+          },
+        ]);
+        const ticket = tickets[0];
+        if (!ticket || !['ok', 'error'].includes(ticket.status))
+          throw new Error('Missing push ticket');
+        const batch = db.batch();
+        if (ticket.status === 'ok') {
+          accepted++;
+          if (ticket.id)
+            batch.set(receipts.doc(ticket.id), {
+              jobId: ref.id,
+              deviceId: device.id,
+              createdAt: FieldValue.serverTimestamp(),
+              status: 'pending',
+            });
+        } else {
+          const reason =
+            ticket.details?.error || ticket.message || 'Push rejected';
+          if (reason === 'MessageRateExceeded') throw new Error(reason);
+          failed++;
+          errors.add(reason);
+          if (reason === 'DeviceNotRegistered')
+            batch.update(device.ref, { enabled: false });
+        }
+        batch.set(attemptRef, {
+          status: ticket.status,
+          ticketId: ticket.id || null,
+        });
+        batch.update(ref, {
+          sentCount: accepted,
+          failedCount: failed,
+          errors: [...errors].slice(0, 5),
+          leaseUntil: Timestamp.fromMillis(Date.now() + 180000),
+        });
+        await batch.commit();
+      }
+      await ref.update({
+        status: deliveryStatus(accepted + failed, accepted, failed),
+        recipients: accepted + failed,
+        sentCount: accepted,
+        failedCount: failed,
+        leaseUntil: null,
+        completedAt: FieldValue.serverTimestamp(),
+      });
+    } catch (error) {
+      const exhausted = (job.attempts || 0) >= 4;
+      await ref.update({
+        status: exhausted ? 'failed' : 'retry',
+        leaseUntil: Timestamp.fromMillis(Date.now() + 60000),
+        errors: [String(error.message || error)],
+        ...(exhausted ? { completedAt: FieldValue.serverTimestamp() } : {}),
+      });
+    }
+  }
+
+  async function saveChat(ref, data, newMessages, append = false) {
+    // Called only after widget authorization/rate limiting. Ignore client-supplied
+    // history: callers pass only the visitor message accepted by this request.
+    const candidates = incomingMessages(null, { messages: newMessages });
+    return db.runTransaction(async (tx) => {
+      const chat = await tx.get(ref);
+      const entries = candidates.map((message) => ({
+        message,
+        ref: jobs.doc(
+          hash(`${data.businessId}:${ref.id}:${messageKey(message)}`),
+        ),
+      }));
+      const existing = await Promise.all(
+        entries.map((entry) => tx.get(entry.ref)),
+      );
+      const previousMessages = chat.data()?.messages || [];
+      const previous = new Set(previousMessages.map(messageKey));
+      const fresh = candidates.filter(
+        (message) => !previous.has(messageKey(message)),
+      );
+      const merged = [...previousMessages, ...fresh];
+      tx.set(
+        ref,
+        append
+          ? { ...data, messages: merged, messageCount: merged.length }
+          : data,
+        { merge: true },
+      );
+      entries.forEach((entry, index) => {
+        if (existing[index].exists || previous.has(messageKey(entry.message)))
+          return;
+        tx.create(entry.ref, {
+          kind: 'chat',
+          title: data.visitorName || data.pageTitle || 'New customer message',
+          body: entry.message.text.slice(0, 300),
+          targetBusinessId: data.businessId,
+          data: {
+            type: 'chat',
+            businessId: data.businessId,
+            chatId: ref.id,
+            widgetKey: data.widgetKey || '',
+          },
+          status: 'queued',
+          createdAt: FieldValue.serverTimestamp(),
+        });
+      });
+      return entries.map((entry) => entry.ref.id);
+    });
+  }
+
+  async function checkReceipts() {
+    const pending = await receipts
+      .where('status', '==', 'pending')
+      .limit(100)
+      .get();
+    const ready = pending.docs.filter(
+      (d) => d.data().createdAt?.toMillis() < Date.now() - 60000,
+    );
+    if (!ready.length) return;
+    const results = await expo('getReceipts', { ids: ready.map((d) => d.id) });
+    for (const receipt of ready) {
+      const result = results[receipt.id];
+      if (
+        !result &&
+        receipt.data().createdAt.toMillis() > Date.now() - 86400000
+      )
+        continue;
+      // Multiple requests can run maintenance concurrently. Count each receipt once.
+      await db.runTransaction(async (tx) => {
+        const current = await tx.get(receipt.ref);
+        if (current.data()?.status !== 'pending') return;
+        const deviceRef = devices.doc(receipt.data().deviceId);
+        const device = await tx.get(deviceRef);
+        tx.update(receipt.ref, {
+          status: result?.status || 'expired',
+          checkedAt: FieldValue.serverTimestamp(),
+        });
+        const job = jobs.doc(receipt.data().jobId);
+        if (result?.status === 'ok')
+          tx.update(job, { confirmedCount: FieldValue.increment(1) });
+        else {
+          tx.update(job, {
+            receiptFailedCount: FieldValue.increment(1),
+            errors: FieldValue.arrayUnion(
+              result?.details?.error || 'Receipt unavailable',
+            ),
+          });
+          if (result?.details?.error === 'DeviceNotRegistered' && device.exists)
+            tx.update(deviceRef, { enabled: false });
+        }
+      });
+    }
+  }
+
+  async function drain(preferredId) {
+    const deadline = Date.now() + 120000;
+    for (const id of Array.isArray(preferredId)
+      ? preferredId
+      : preferredId
+        ? [preferredId]
+        : []) {
+      if (Date.now() + 22000 > deadline) break;
+      await deliver(jobs.doc(id), deadline);
+    }
+    const pending = await jobs
+      .where('status', 'in', ['queued', 'retry', 'sending'])
+      .limit(30)
+      .get();
+    for (const job of pending.docs) {
+      if (Date.now() + 22000 > deadline) break;
+      await deliver(job.ref, deadline);
+    }
+    if (Date.now() + 22000 < deadline) await checkReceipts();
+  }
+  return {
+    registerNotificationDevice,
+    unregisterNotificationDevice,
+    notificationCenter,
+    queueAnnouncement,
+    saveChat,
+    drain,
+  };
+}
diff --git a/my-app/tests/notification-memory-db.mjs b/my-app/tests/notification-memory-db.mjs
new file mode 100644
index 0000000..7bb054f
--- /dev/null
+++ b/my-app/tests/notification-memory-db.mjs
@@ -0,0 +1,129 @@
+// Deliberately isolated fake for behavioral tests. No Firebase credentials/network.
+import assert from 'node:assert/strict';
+import { Timestamp } from 'firebase-admin/firestore';
+export function memoryDb() {
+  const store = new Map();
+  let lock = Promise.resolve();
+  function apply(path, values, merge = true) {
+    const data = merge ? { ...store.get(path) } : {};
+    for (const [key, value] of Object.entries(values)) {
+      switch (value?.constructor?.name) {
+        case 'ServerTimestampTransform':
+          data[key] = Timestamp.now();
+          break;
+        case 'NumericIncrementTransform':
+          data[key] = (data[key] || 0) + value.operand;
+          break;
+        case 'ArrayUnionTransform':
+          data[key] = [...new Set([...(data[key] || []), ...value.elements])];
+          break;
+        case 'DeleteTransform':
+          delete data[key];
+          break;
+        default:
+          data[key] = value;
+      }
+    }
+    store.set(path, data);
+  }
+  const snapshot = (ref) => ({
+    id: ref.id,
+    ref,
+    exists: store.has(ref.path),
+    data: () => store.get(ref.path),
+  });
+  function doc(path) {
+    const ref = {
+      path,
+      id: path.split('/').at(-1),
+      collection: (key) => collection(`${path}/${key}`),
+      get: async () => snapshot(ref),
+      set: async (data, opts) => apply(path, data, !!opts?.merge),
+      update: async (data) => {
+        assert.ok(store.has(path));
+        apply(path, data);
+      },
+    };
+    return ref;
+  }
+  function collection(path, filters = [], max = Infinity, sort = undefined) {
+    return {
+      doc: (id) => doc(`${path}/${id}`),
+      where: (key, op, value) =>
+        collection(path, [...filters, [key, op, value]], max, sort),
+      limit: (limit) => collection(path, filters, limit, sort),
+      orderBy: (key, direction) =>
+        collection(path, filters, max, [key, direction]),
+      get: async () => {
+        let entries = [...store].filter(
+          ([p, data]) =>
+            p.startsWith(path + '/') &&
+            !p.slice(path.length + 1).includes('/') &&
+            filters.every(([key, op, value]) =>
+              op === '=='
+                ? data[key] === value
+                : op === 'in'
+                  ? value.includes(data[key])
+                  : op === 'array-contains'
+                    ? data[key]?.includes(value)
+                    : false,
+            ),
+        );
+        if (sort)
+          entries.sort(
+            (a, b) =>
+              (Number(a[1][sort[0]]?.toMillis?.() || 0) -
+                Number(b[1][sort[0]]?.toMillis?.() || 0)) *
+              (sort[1] === 'desc' ? -1 : 1),
+          );
+        const docs = entries.slice(0, max).map(([p]) => snapshot(doc(p)));
+        return { docs, size: docs.length, empty: !docs.length };
+      },
+    };
+  }
+  function batch() {
+    const writes = [];
+    return {
+      get: async (ref) => {
+        assert.equal(
+          writes.length,
+          0,
+          'Firestore requires reads before writes',
+        );
+        return snapshot(ref);
+      },
+      set: (ref, data, opts) =>
+        writes.push(() => apply(ref.path, data, !!opts?.merge)),
+      create: (ref, data) =>
+        writes.push(() => {
+          assert.ok(!store.has(ref.path), 'create must not overwrite');
+          apply(ref.path, data, false);
+        }),
+      update: (ref, data) =>
+        writes.push(() => {
+          assert.ok(store.has(ref.path), 'update needs document');
+          apply(ref.path, data);
+        }),
+      delete: (ref) => writes.push(() => store.delete(ref.path)),
+      commit: async () => {
+        for (const write of writes) write();
+      },
+    };
+  }
+  return {
+    store,
+    doc,
+    collection,
+    batch,
+    runTransaction: (fn) => {
+      const task = lock.then(async () => {
+        const tx = batch();
+        const result = await fn(tx);
+        await tx.commit();
+        return result;
+      });
+      lock = task.catch(() => {});
+      return task;
+    },
+  };
+}
diff --git a/my-app/tests/notifications.test.mjs b/my-app/tests/notifications.test.mjs
new file mode 100644
index 0000000..55596b3
--- /dev/null
+++ b/my-app/tests/notifications.test.mjs
@@ -0,0 +1,263 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { Timestamp } from 'firebase-admin/firestore';
+import { createNotificationService } from '../src/lib/notifications/service.mjs';
+import { createNotificationHandler } from '../src/lib/notifications/http.mjs';
+import { hash } from '../src/lib/notifications/core.mjs';
+import { memoryDb } from './notification-memory-db.mjs';
+
+const staff = {
+  uid: 'staff',
+  token: { email_verified: true, email: 'staff@example.com' },
+};
+const admin = {
+  uid: 'admin',
+  token: { email_verified: true, superAdmin: true },
+};
+const deviceToken = 'ExpoPushToken[test-device]';
+const req = (auth, data) => ({ auth, data });
+async function setup(
+  fetchImpl = async () =>
+    Response.json({ data: [{ status: 'ok', id: 'receipt1' }] }),
+) {
+  const db = memoryDb();
+  await db.doc('businesses/b1').set({ ownerId: 'owner', name: 'Test' });
+  await db
+    .doc('businesses/b1/users/staff')
+    .set({ role: 'support', status: 'active' });
+  const service = createNotificationService(db, { fetchImpl });
+  await service.registerNotificationDevice(
+    req(staff, {
+      token: deviceToken,
+      businessIds: ['b1', 'outside'],
+      platform: 'ios',
+    }),
+  );
+  return { db, service };
+}
+const message = {
+  id: 'm1',
+  role: 'user',
+  text: 'Hello',
+  createdAt: '2026-01-01',
+};
+async function save(db, service, messages = [message]) {
+  return service.saveChat(
+    db.doc('businesses/b1/supportChats/c1'),
+    {
+      businessId: 'b1',
+      widgetKey: 'widget1',
+      messages,
+      visitorName: 'Visitor',
+    },
+    messages,
+    true,
+  );
+}
+
+test('verified device is restricted to active businesses; another user cannot unregister it', async () => {
+  const { db, service } = await setup();
+  const key = `notificationDevices/${hash(deviceToken)}`;
+  assert.deepEqual(db.store.get(key).businessIds, ['b1']);
+  await service.unregisterNotificationDevice(
+    req(admin, { token: deviceToken }),
+  );
+  assert.ok(db.store.has(key));
+  await service.unregisterNotificationDevice(
+    req(staff, { token: deviceToken }),
+  );
+  assert.equal(db.store.has(key), false);
+  await assert.rejects(
+    () => service.registerNotificationDevice(req({ ...staff, token: {} }, {})),
+    { code: 'unauthenticated' },
+  );
+});
+test('visitor message and job persist together; replay, staff and AI replies do not duplicate alerts', async () => {
+  const sent = [];
+  const { db, service } = await setup(async (_, options) => {
+    sent.push(JSON.parse(options.body));
+    return Response.json({ data: [{ status: 'ok', id: 'r' }] });
+  });
+  await save(db, service);
+  await save(db, service, [
+    message,
+    { id: 'a1', role: 'assistant', text: 'Answer' },
+  ]);
+  await Promise.all([service.drain(), service.drain()]);
+  assert.equal(sent.length, 1);
+  assert.deepEqual(sent[0][0].data, {
+    type: 'chat',
+    businessId: 'b1',
+    chatId: 'c1',
+    widgetKey: 'widget1',
+    notificationId: hash('b1:c1:m1'),
+  });
+  assert.equal(db.store.get('businesses/b1/supportChats/c1').messageCount, 1);
+  assert.equal(
+    db.store.get(`notificationJobs/${hash('b1:c1:m1')}`).status,
+    'accepted',
+  );
+});
+test('revoked membership and disabled devices receive no chat pushes', async () => {
+  let sends = 0;
+  const { db, service } = await setup(async () => {
+    sends++;
+    return Response.json({ data: [] });
+  });
+  await save(db, service);
+  await db.doc('businesses/b1/users/staff').update({ status: 'disabled' });
+  await service.drain();
+  assert.equal(sends, 0);
+  assert.equal(
+    db.store.get(`notificationJobs/${hash('b1:c1:m1')}`).status,
+    'no-recipients',
+  );
+});
+test('network failure stays retryable; accepted retry is not sent again', async () => {
+  let sends = 0;
+  const { db, service } = await setup(async () => {
+    if (++sends === 1) throw new Error('offline');
+    return Response.json({ data: [{ status: 'ok', id: 'r' }] });
+  });
+  await save(db, service);
+  await service.drain();
+  const job = db.doc(`notificationJobs/${hash('b1:c1:m1')}`);
+  assert.equal((await job.get()).data().status, 'retry');
+  await job.update({ leaseUntil: null });
+  await service.drain();
+  await service.drain();
+  assert.equal(sends, 2);
+  assert.equal((await job.get()).data().status, 'accepted');
+});
+test('unregistered tokens are disabled and send is recorded as failed', async () => {
+  const { db, service } = await setup(async () =>
+    Response.json({
+      data: [{ status: 'error', details: { error: 'DeviceNotRegistered' } }],
+    }),
+  );
+  await save(db, service);
+  await service.drain();
+  assert.equal(
+    db.store.get(`notificationDevices/${hash(deviceToken)}`).enabled,
+    false,
+  );
+  assert.equal(
+    db.store.get(`notificationJobs/${hash('b1:c1:m1')}`).status,
+    'failed',
+  );
+});
+test('announcements require administrator, test token ownership and stable request IDs', async () => {
+  const { db, service } = await setup();
+  const data = {
+    title: 'Hello',
+    body: 'World',
+    targetBusinessId: 'all',
+    requestId: 'request-123456',
+  };
+  await assert.rejects(() => service.queueAnnouncement(req(staff, data)), {
+    code: 'permission-denied',
+  });
+  await assert.rejects(
+    () =>
+      service.queueAnnouncement(
+        req(admin, { ...data, testToken: deviceToken }),
+      ),
+    { code: 'permission-denied' },
+  );
+  const first = await service.queueAnnouncement(req(admin, data));
+  const second = await service.queueAnnouncement(req(admin, data));
+  assert.equal(first.id, second.id);
+  assert.equal((await db.collection('notificationJobs').get()).size, 1);
+});
+test('concurrent receipt checks count provider confirmation once', async () => {
+  const { db, service } = await setup(async (url) =>
+    Response.json({
+      data: url.endsWith('getReceipts')
+        ? { receipt1: { status: 'ok' } }
+        : [{ status: 'ok', id: 'receipt1' }],
+    }),
+  );
+  await save(db, service);
+  await service.drain();
+  await db
+    .doc('notificationReceipts/receipt1')
+    .update({ createdAt: Timestamp.fromMillis(Date.now() - 120000) });
+  await Promise.all([service.drain(), service.drain()]);
+  assert.equal(
+    db.store.get(`notificationJobs/${hash('b1:c1:m1')}`).confirmedCount,
+    1,
+  );
+});
+test('HTTP blocks unsigned, unverified, malformed, disallowed-origin and disabled requests before service use', async () => {
+  let calls = 0;
+  let enabled = true;
+  const handle = createNotificationHandler({
+    enabled: () => enabled,
+    origins: ['https://chat.vintrastudio.com'],
+    verifyToken: async (token) => ({
+      uid: 'staff',
+      email_verified: token === 'verified',
+    }),
+    service: () => {
+      calls++;
+      throw new Error('must not run');
+    },
+    schedule: () => {},
+  });
+  const request = (token, input, origin) =>
+    new Request('https://test/api/notifications', {
+      method: 'POST',
+      headers: {
+        ...(token ? { Authorization: `Bearer ${token}` } : {}),
+        ...(origin ? { Origin: origin } : {}),
+      },
+      body: JSON.stringify(input),
+    });
+  const data = { action: 'registerNotificationDevice', data: {} };
+  assert.equal((await handle(request(null, data))).status, 401);
+  assert.equal((await handle(request('unverified', data))).status, 403);
+  assert.equal(
+    (await handle(request('verified', data, 'https://evil.example'))).status,
+    403,
+  );
+  assert.equal(
+    (await handle(request('verified', { action: 'drain', data: {} }))).status,
